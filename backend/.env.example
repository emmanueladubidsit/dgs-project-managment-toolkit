# Copy to backend/.env. Never commit .env.
DATABASE_URL=postgresql+psycopg://dgs:dgs_local_dev@localhost:5433/dgs_workspace
TEST_DATABASE_URL=postgresql+psycopg://dgs:dgs_local_dev@localhost:5433/dgs_workspace_test
CORS_ORIGINS=http://localhost:3010
LOG_LEVEL=INFO
# Voice & Writing (optional). Install local Whisper with: uv sync --extra voice
TRANSCRIPTION_PROVIDER=auto
WHISPER_MODEL=base
VOICE_RETENTION=delete
